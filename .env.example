# Sao chép file này thành `.env` rồi sửa cho đúng môi trường local.
#   copy .env.example .env
#
# Máy tính và điện thoại phải cùng WiFi.
# Lấy IP máy chạy backend: Windows `ipconfig` → IPv4 Address
#
# Android emulator : http://10.0.2.2:8080/api/v1
# iOS simulator    : http://127.0.0.1:8080/api/v1
# Điện thoại thật  : http://<IP-LAN-cua-may>:8080/api/v1

API_BASE_URL=http://192.168.1.7:8080/api/v1

# ─── Firebase (FlutterFire) ───────────────────────────────────────────────────
# Lấy từ Firebase Console → Project settings → Your apps → API Key
# KHÔNG commit file .env (đã có trong .gitignore).
FIREBASE_WEB_API_KEY=
FIREBASE_ANDROID_API_KEY=
FIREBASE_IOS_API_KEY=
